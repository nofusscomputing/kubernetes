apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

components:
  - ../../components/ingress
  # - ../../components/rabbitmq-setup
  - ../../components/service-monitor
  # - ../../components/sso-keycloak

# configMapGenerator:
#   - name: configuration
#     files:
#       - settings.py

generatorOptions:
  disableNameSuffixHash: true

#
#  to update image tag, cd to kustomize.yaml dir and run with image and tag
#  kustomize edit set image nofusscomputing/centurion-erp:tester
#
images:
  - name: nofusscomputing/centurion-erp
    newTag: {{ versions.centurion_erp.git_sha_version_latest }}

  - name: nofusscomputing/centurion-ui
    newTag: {{ versions.centurion_ui.git_sha_version_latest }}

labels:
  - includeSelectors: true
    pairs:
      app.kubernetes.io/instance: cluster

  - pairs:
      app.kubernetes.io/version: '{{ versions.centurion_erp.git_version_latest }}'

namespace: centurion

